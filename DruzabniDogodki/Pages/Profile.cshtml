@page
@model DruzabniDogodki.Pages.ProfileModel
@{
    ViewData["Title"] = "Profil";
}

<section class="profile-container">

    <h1 class="profile-title">Nastavitve profila</h1>
    <p class="profile-subtitle">Tukaj lahko urejaš svoje podatke.</p>

    <form method="post" class="profile-form">

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <div class="alert alert-success">@Model.Message</div>
        }

        <input type="hidden" asp-for="User.Id" />

        <div class="profile-group">
            <label asp-for="User.UserName" class="profile-label"></label>
            <input asp-for="User.UserName" class="profile-input" />
            <span asp-validation-for="User.UserName" class="profile-error"></span>
        </div>

        <div class="profile-group">
            <label asp-for="User.Email" class="profile-label"></label>
            <input asp-for="User.Email" class="profile-input" />
            <span asp-validation-for="User.Email" class="profile-error"></span>
        </div>

        <div class="profile-group">
            <label asp-for="User.Password" class="profile-label"></label>
            <input asp-for="User.Password" class="profile-input" />
            <span asp-validation-for="User.Password" class="profile-error"></span>
        </div>

        <button type="submit" class="btn-save">Shrani spremembe</button>
    </form>

    
    <section class="danger-zone">
        <h2>Nevarna cona</h2>
        <p>Pozor: Brisanje profila je trajno dejanje in ga ni mogoče razveljaviti.</p>

        <form method="post" asp-page-handler="Delete">
            <button type="submit" class="btn-danger">Izbriši račun</button>
        </form>
    </section>

</section>

@section Styles {
    <style>
        :root {
            --bg: #0f172a;
            --card: #111827;
            --text: #e5e7eb;
            --muted: #9ca3af;
            --primary: #3b82f6;
            --primary-hover: #2563eb;
            --error: #ef4444;
            --danger-bg: #3f0d0d;
            --danger-border: #7f1d1d;
        }

        
        .profile-container {
            max-width: 650px;
            margin: 40px auto;
            padding: 20px;
            color: var(--text);
        }

        .profile-title {
            font-size: 2rem;
            margin-bottom: 0.3rem;
            font-weight: 600;
        }

        .profile-subtitle {
            color: var(--muted);
            margin-bottom: 2rem;
        }

        
        .profile-form {
            display: grid;
            gap: 1.5rem;
            background: var(--card);
            padding: 1.5rem;
            border-radius: 12px;
            border: 1px solid var(--border);
        }

        .profile-group {
            display: grid;
            gap: 0.4rem;
        }

        .profile-label {
            font-size: 0.9rem;
            color: var(--muted);
        }

        .profile-input {
            width: 100%;
            padding: 0.75rem 1rem;
            background: #1f2937;
            border: 1px solid #374151;
            border-radius: 10px;
            color: var(--text);
            outline: none;
            transition: 0.15s ease;
        }

            .profile-input:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 3px rgba(59,130,246,0.25);
            }

        .profile-error {
            color: var(--error);
            font-size: 0.85rem;
        }

       
        .btn-save {
            padding: 0.8rem;
            background: linear-gradient(180deg, var(--primary), var(--primary-hover));
            border: none;
            border-radius: 10px;
            color: white;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 8px 18px rgba(37, 99, 235, 0.35);
            transition: 0.15s ease;
        }

            .btn-save:hover {
                filter: brightness(1.05);
            }

        
        .danger-zone {
            margin-top: 30px;
            padding: 20px;
            border: 1px solid var(--danger-border);
            background: var(--danger-bg);
            border-radius: 12px;
        }

            .danger-zone h2 {
                color: #f87171;
                margin-bottom: 0.3rem;
            }

        .btn-danger {
            padding: 0.8rem;
            background: #dc2626;
            border: none;
            color: white;
            font-weight: 600;
            border-radius: 10px;
            margin-top: 10px;
            cursor: pointer;
            width: 100%;
            transition: 0.15s;
        }

            .btn-danger:hover {
                background: #b91c1c;
            }
    </style>
}
