@page
@model DruzabniDogodki.Pages.Events.IndexModel

@{
    ViewData["Title"] = "Moji dogodki";
}

<h2>Moji dogodki</h2>

<p>
    <a asp-page="/Events/Create" class="btn btn-primary">➕ Nov dogodek</a>
</p>

@if (!Model.Events.Any())
{
    <p>Trenutno nimaš nobenega dogodka.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Naslov</th>
                <th>Datum</th>
                <th>Lokacija</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.EventDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@e.Location</td>
                <td>
                    <!-- Gumb Uredi odpre modal -->
                    <button type="button"
                            class="btn btn-sm btn-secondary"
                            data-bs-toggle="modal"
                            data-bs-target="#editModal"
                            data-id="@e.Id"
                            data-title="@e.Title"
                            data-description="@e.Description"
                            data-date="@e.EventDate.ToString("yyyy-MM-ddTHH\\:mm")"
                            data-location="@e.Location">
                        Uredi
                    </button>

                    <!-- Gumb Izbriši pošlje POST na handler Delete -->
                    <form method="post"
                          asp-page-handler="Delete"
                          asp-route-id="@e.Id"
                          class="d-inline">
                        <button type="submit"
                                class="btn btn-sm btn-danger"
                                onclick="return confirm('Res želiš izbrisati ta dogodek?');">
                            Izbriši
                        </button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<!-- EDIT MODAL -->
<div class="modal fade" id="editModal" tabindex="-1" aria-labelledby="editModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Edit">
                <div class="modal-header">
                    <h5 class="modal-title" id="editModalLabel">Uredi dogodek</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zapri"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="edit-id" />

                    <div class="mb-3">
                        <label for="edit-title" class="form-label">Naslov</label>
                        <input type="text" class="form-control" id="edit-title" name="title" required />
                    </div>

                    <div class="mb-3">
                        <label for="edit-description" class="form-label">Opis</label>
                        <textarea class="form-control" id="edit-description" name="description"></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="edit-date" class="form-label">Datum in čas</label>
                        <input type="datetime-local" class="form-control" id="edit-date" name="eventDate" required />
                    </div>

                    <div class="mb-3">
                        <label for="edit-location" class="form-label">Lokacija</label>
                        <input type="text" class="form-control" id="edit-location" name="location" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Prekliči</button>
                    <button type="submit" class="btn btn-primary">Shrani</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Ko se modal odpre, napolnimo inpute z vrednostmi iz gumba
        var editModal = document.getElementById('editModal');
        editModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;

            var id = button.getAttribute('data-id');
            var title = button.getAttribute('data-title');
            var description = button.getAttribute('data-description');
            var date = button.getAttribute('data-date');
            var location = button.getAttribute('data-location');

            document.getElementById('edit-id').value = id;
            document.getElementById('edit-title').value = title;
            document.getElementById('edit-description').value = description || '';
            document.getElementById('edit-date').value = date;
            document.getElementById('edit-location').value = location || '';
        });
    </script>
}
