@page
@model DruzabniDogodki.Pages.Events.IndexModel

@{
    ViewData["Title"] = "Moji dogodki";
}

<h2>@(Model.IsAdmin ? "Moji dogodki" : "Vsi dogodki")</h2>

<div class="d-flex align-items-center justify-content-between mb-3">
    <form method="get" class="d-flex" role="search">
        <input type="text"
               name="q"
               value="@Model.Query"
               class="form-control"
               placeholder="Išči po naslovu, opisu ali lokaciji"
               style="max-width: 320px;" />
        <button type="submit" class="btn btn-outline-secondary ms-2">Išči</button>
        @* ohrani sort & dir pri iskanju *@
        <input type="hidden" name="sort" value="@Model.Sort" />
        <input type="hidden" name="dir" value="@Model.Dir" />
    </form>

    <div>
        <a asp-page="/Events/Calendar" class="btn btn-outline-primary">📅 Koledar</a>
        @if (Model.IsAdmin)
        {
            <a asp-page="/Events/Create" class="btn btn-primary ms-2">➕ Nov dogodek</a>
        }
    </div>
</div>

@if (!Model.Events.Any())
{
    <p>@(Model.IsAdmin ? "Trenutno nimaš nobenega dogodka." : "Trenutno ni razpoložljivih dogodkov.")</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>
                    <a asp-page="./Index"
                       asp-route-q="@Model.Query"
                       asp-route-sort="title"
                       asp-route-dir="@(Model.Sort == "title" && Model.Dir == "asc" ? "desc" : "asc")">
                        Naslov
                        @(Model.Sort == "title" ? (Model.Dir == "asc" ? "▲" : "▼") : "")
                    </a>
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-q="@Model.Query"
                       asp-route-sort="date"
                       asp-route-dir="@(Model.Sort == "date" && Model.Dir == "asc" ? "desc" : "asc")">
                        Datum
                        @(Model.Sort == "date" ? (Model.Dir == "asc" ? "▲" : "▼") : "")
                    </a>
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-q="@Model.Query"
                       asp-route-sort="location"
                       asp-route-dir="@(Model.Sort == "location" && Model.Dir == "asc" ? "desc" : "asc")">
                        Lokacija
                        @(Model.Sort == "location" ? (Model.Dir == "asc" ? "▲" : "▼") : "")
                    </a>
                </th>
                @if (Model.IsAdmin)
                {
                    <th>Akcije</th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.EventDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@e.Location</td>
                @if (Model.IsAdmin)
                {
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-secondary"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal"
                                data-id="@e.Id"
                                data-title="@e.Title"
                                data-description="@e.Description"
                                data-date="@e.EventDate.ToString("yyyy-MM-ddTHH\\:mm")"
                                data-location="@e.Location">
                            Uredi
                        </button>

                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-id="@e.Id"
                              class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('Res želiš izbrisati ta dogodek?');">
                                Izbriši
                            </button>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}
