@page
@model DruzabniDogodki.Pages.Events.IndexModel

@{
    ViewData["Title"] = "Moji dogodki";
}

<h2>@(Model.IsAdmin ? "Moji dogodki" : "Vsi dogodki")</h2>

@if (Model.IsAdmin)
{
    <p>
        <a asp-page="/Events/Create" class="btn btn-primary">➕ Nov dogodek</a>
    </p>
}

@if (!Model.Events.Any())
{
    <p>@(Model.IsAdmin ? "Trenutno nimaš nobenega dogodka." : "Trenutno ni razpoložljivih dogodkov.")</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Naslov</th>
                <th>Datum</th>
                <th>Lokacija</th>
                @if (Model.IsAdmin)
                {
                    <th>Akcije</th>
                }
            </tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Events)
        {
            <tr>
                <td>@e.Title</td>
                <td>@e.EventDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@e.Location</td>
                @if (Model.IsAdmin)
                {
                    <td>
                        <!-- Gumb Uredi odpre modal -->
                        <button type="button"
                                class="btn btn-sm btn-secondary"
                                data-bs-toggle="modal"
                                data-bs-target="#editModal"
                                data-id="@e.Id"
                                data-title="@e.Title"
                                data-description="@e.Description"
                                data-date="@e.EventDate.ToString("yyyy-MM-ddTHH\\:mm")"
                                data-location="@e.Location">
                            Uredi
                        </button>

                        <!-- Gumb Izbriši pošlje POST na handler Delete -->
                        <form method="post"
                              asp-page-handler="Delete"
                              asp-route-id="@e.Id"
                              class="d-inline">
                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('Res želiš izbrisati ta dogodek?');">
                                Izbriši
                            </button>
                        </form>
                    </td>
                }
            </tr>
        }
        </tbody>
    </table>
}
