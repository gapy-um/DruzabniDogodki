@page
@model DruzabniDogodki.Pages.Reservations.IndexModel
@{
    ViewData["Title"] = "Moje rezervacije";
}

<div class="container mt-4" style="max-width: 900px;">
    <h2 class="mb-3">🎫 Moje rezervacije</h2>

    <div class="mb-3">
        <a asp-page="/Events/Index" class="btn btn-sm btn-outline-secondary">← Nazaj na dogodke</a>
    </div>

    @if (!Model.Reservations.Any())
    {
        <div class="alert alert-info">Nimaš še nobene rezervacije.</div>
    }
    else
    {
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Dogodek</th>
                    <th>Datum</th>
                    <th>Kraj</th>
                    <th>Količina</th>
                    <th>Rezervirano</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var r in Model.Reservations)
            {
                <tr>
                    <td>
                        <a asp-page="/Events/Details" asp-route-id="@r.EventId" class="text-decoration-none fw-semibold">
                            @r.EventTitle
                        </a>
                    </td>
                    <td>@r.EventDate.ToString("dd.MM.yyyy HH:mm")</td>
                    <td>@r.Location</td>
                    <td>@r.Quantity</td>
                    <td>@r.CreatedAt</td>
                    <td class="text-nowrap">
                        <form method="post" asp-page-handler="Cancel" asp-route-id="@r.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('Prekličem rezervacijo?');">
                                Prekliči
                            </button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</div>
