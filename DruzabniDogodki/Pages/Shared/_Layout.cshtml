@using Microsoft.AspNetCore.Http
@using System

<!DOCTYPE html>
<html lang="sl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DruzabniDogodki</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DruzabniDogodki.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        .nav-main { box-shadow: none; border-bottom: none; background-color: #020617; }
        .nav-main .navbar-brand, .nav-main .nav-link { color: #e5e7eb !important; }
        .nav-main .nav-link:hover { color: #ffffff !important; }
        .nav-main .navbar-text { color: #e5e7eb !important; }
    </style>
</head>

<body>
@{
    var currentPage = ViewContext.RouteData.Values["page"] as string ?? "";

    var userName = Context.Session.GetString("UserName");
    var role = Context.Session.GetString("Role") ?? "User";

    bool isLoggedIn = !string.IsNullOrEmpty(userName);
    bool isAdmin =
        string.Equals(userName, "admin", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(role, "Admin", StringComparison.OrdinalIgnoreCase);

    bool onAuthPage =
        string.Equals(currentPage, "/Login", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentPage, "/Register", StringComparison.OrdinalIgnoreCase);

    // ✅ Admin "Domov" gre na Admin panel
    var homePage = isAdmin ? "/Admin/Index" : "/Index";
}

<header>
    <nav class="navbar navbar-expand-sm navbar-dark nav-main mb-3">
        <div class="container">

            <a class="navbar-brand" asp-page="@homePage">DruzabniDogodki</a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div id="mainNavbar" class="collapse navbar-collapse">

                <!-- LEVO -->
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link @(currentPage == homePage ? "fw-semibold" : "")"
                           asp-page="@homePage">
                            Domov
                        </a>
                    </li>

                    @if (isLoggedIn)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Events/All" ? "fw-semibold" : "")"
                               asp-page="/Events/All">Vsi dogodki</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Reservations/Index" ? "fw-semibold" : "")"
                               asp-page="/Reservations/Index">Moje rezervacije</a>
                        </li>

                        @if (isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Events/Index" ? "fw-semibold" : "")"
                                   asp-page="/Events/Index">Upravljaj dogodke</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Events/Create" ? "fw-semibold" : "")"
                                   asp-page="/Events/Create">+ Nov dogodek</a>
                            </li>

                            <!-- ✅ NOVO: Uporabniki -->
                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Admin/Users", StringComparison.OrdinalIgnoreCase) ? "fw-semibold" : "")"
                                   asp-page="/Admin/Users">Uporabniki</a>
                            </li>
                        }
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Events/All" ? "fw-semibold" : "")"
                               asp-page="/Events/All">Dogodki</a>
                        </li>
                    }
                </ul>

                <!-- DESNO -->
                @if (isLoggedIn)
                {
                    <ul class="navbar-nav ms-auto align-items-sm-center">
                        <li class="nav-item">
                            <span class="navbar-text me-3">
                                Pozdravljen, @userName
                                @if (isAdmin)
                                {
                                    <span class="badge bg-success ms-2">Admin</span>
                                }
                            </span>
                        </li>

                        <li class="nav-item">
                            <button id="themeToggle" class="btn btn-sm btn-outline-light ms-2" type="button">
                                Dark mode
                            </button>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Account/Profile" ? "fw-semibold" : "")"
                               asp-page="/Account/Profile">Profil</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Logout">Odjava</a>
                        </li>
                    </ul>
                }
                else if (!onAuthPage)
                {
                    <ul class="navbar-nav ms-auto align-items-sm-center">
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Login">Prijava</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Register">Registracija</a>
                        </li>

                        <li class="nav-item">
                            <button id="themeToggle" class="btn btn-sm btn-outline-light ms-2" type="button">
                                Dark mode
                            </button>
                        </li>
                    </ul>
                }

            </div>
        </div>
    </nav>
</header>

<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2025 - DruzabniDogodki
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const body = document.body;
        const btn = document.getElementById("themeToggle");
        if (!btn) return;

        const saved = localStorage.getItem("theme");
        if (saved === "dark") {
            body.classList.add("dark-mode");
            btn.textContent = "Light mode";
        }

        btn.addEventListener("click", function () {
            const isDark = body.classList.toggle("dark-mode");
            localStorage.setItem("theme", isDark ? "dark" : "light");
            btn.textContent = isDark ? "Light mode" : "Dark mode";
        });
    });
</script>
</body>
</html>
