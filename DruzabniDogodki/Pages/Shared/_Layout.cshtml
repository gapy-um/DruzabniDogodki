@using Microsoft.AspNetCore.Http
@using System

<!DOCTYPE html>
<html lang="sl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DruzabniDogodki</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DruzabniDogodki.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        .nav-main {
            box-shadow: none;
            border-bottom: none;
            background-color: #020617;
        }
        .nav-main .navbar-brand,
        .nav-main .nav-link {
            color: #e5e7eb !important;
        }
        .nav-main .nav-link:hover {
            color: #ffffff !important;
        }
        /* Lep dropdown meni */
        .user-dropdown svg {
            transition: 0.15s ease;
        }

        .user-dropdown:hover svg {
            transform: scale(1.1);
        }

        .username-text {
            color: #e5e7eb;
            font-size: 0.95rem;
        }

        /* Dropdown meni */
        .user-menu {
            background-color: #111827;
            border: 1px solid #374151;
            border-radius: 8px;
        }

            .user-menu .dropdown-item {
                color: #e5e7eb;
            }

                .user-menu .dropdown-item:hover {
                    background-color: #1f2937;
                    color: #fff;
                }

            .user-menu .dropdown-divider {
                border-color: #374151;
            }

    </style>
</head>

<body>
    @{
        var currentPage = ViewContext.RouteData.Values["page"] as string ?? "";
        var userName = Context.Session.GetString("UserName");
        bool isLoggedIn = !string.IsNullOrEmpty(userName);

        bool onAuthPage =
            string.Equals(currentPage, "/Login", StringComparison.OrdinalIgnoreCase) ||
            string.Equals(currentPage, "/Register", StringComparison.OrdinalIgnoreCase);
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark nav-main mb-3">
            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand" asp-area="" asp-page="/Index">DruzabniDogodki</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="collapse navbar-collapse">
                    
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Index" ? "fw-semibold" : "")"
                               asp-page="/Index">Domov</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/About">O projektu</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Events/Index">Dogodki</a>
                        </li>
                    </ul>

                    
                    @if (isLoggedIn)
                    {
                        <ul class="navbar-nav ms-auto align-items-center">

                            
                            <li class="nav-item me-3">
                                <button id="themeToggle"
                                        class="btn btn-sm btn-outline-light"
                                        type="button">
                                    Tema
                                </button>
                            </li>

                           
                            <li class="nav-item dropdown">

                                <a class="nav-link dropdown-toggle d-flex align-items-center user-dropdown"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                    <span class="me-2 username-text">Pozdravljen, <b>@userName</b></span>

                                    
                                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26"
                                         fill="#e5e7eb" viewBox="0 0 16 16">
                                        <path d="M3 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H3zm5-6a3 3 0 1 0 0-6
                            3 3 0 0 0 0 6z" />
                                    </svg>

                                </a>

                                <ul class="dropdown-menu dropdown-menu-end user-menu">

                                    <li>
                                        <a class="dropdown-item" asp-page="/Profile">Profil</a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item" asp-page="/Events/MyEvents">Moji dogodki</a>
                                    </li>

                                    <li><hr class="dropdown-divider" /></li>

                                    <li>
                                        <a class="dropdown-item text-danger" asp-page="/Logout">Odjava</a>
                                    </li>

                                </ul>

                            </li>
                        </ul>
                    }
                    else if (!onAuthPage)
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Login">Prijava</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-page="/Register">Registracija</a>
                            </li>

                            <li class="nav-item me-3">
                                <button id="themeToggle"
                                        class="btn btn-sm btn-outline-light"
                                        type="button">
                                    Tema
                                </button>
                            </li>
                        </ul>
                    }
                </div>

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - DruzabniDogodki - <a asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Skripte -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- DARK/LIGHT MODE SCRIPT -->
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const body = document.body;
            const btn = document.getElementById("themeToggle");

            if (!btn) return;

            const saved = localStorage.getItem("theme");
            if (saved === "dark") {
                body.classList.add("dark-mode");
                btn.textContent = "Light mode";
            }

            btn.addEventListener("click", function () {
                const isDark = body.classList.toggle("dark-mode");
                localStorage.setItem("theme", isDark ? "dark" : "light");
                btn.textContent = isDark ? "Light mode" : "Dark mode";
            });
        });
    </script>
</body>
</html>
