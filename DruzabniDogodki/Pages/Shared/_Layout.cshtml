@using Microsoft.AspNetCore.Http
@using System

<!DOCTYPE html>
<html lang="sl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DruzabniDogodki</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DruzabniDogodki.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <style>
        /* Temen navbar, da se ujema z auth backgroundom */
        .nav-main {
            box-shadow: none;
            border-bottom: none;
            background-color: #020617;
        }

            .nav-main .navbar-brand,
            .nav-main .nav-link {
                color: #e5e7eb !important;
            }

                .nav-main .nav-link:hover {
                    color: #ffffff !important;
                }
    </style>
</head>
<body>
    @{
        // na kateri strani smo ("/Index", "/Login", "/Register"...)
        var currentPage = ViewContext.RouteData.Values["page"] as string ?? "";

        // iz Session preberemo username (če obstaja)
        var userName = Context.Session.GetString("UserName");
        bool isLoggedIn = !string.IsNullOrEmpty(userName);

        // smo na eni od auth strani?
        bool onAuthPage =
        string.Equals(currentPage, "/Login", StringComparison.OrdinalIgnoreCase) ||
        string.Equals(currentPage, "/Register", StringComparison.OrdinalIgnoreCase);
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark nav-main mb-3">
            <div class="container">

                <!-- LOGO -->
                <a class="navbar-brand" asp-area="" asp-page="/Index">DruzabniDogodki</a>

                <!-- Mobile toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="collapse navbar-collapse">

                    <!-- LEVA STRAN MENIJA -->
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentPage == "/Index" ? "fw-semibold" : "")"
                               asp-area="" asp-page="/Index">Domov</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/About">O projektu</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Events">Dogodki</a>
                        </li>
                    </ul>

                    <!-- DESNA STRAN MENIJA -->
                    @if (isLoggedIn)
                    {
                        <!-- uporabnik je prijavljen -->
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <span class="navbar-text me-3">
                                    Pozdravljen, @userName
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Logout">Odjava</a>
                            </li>
                        </ul>
                    }
                    else if (!onAuthPage)
                    {
                        <!-- uporabnik NI prijavljen in NISMO na /Login ali /Register -->
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Login">Prijava</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Register">Registracija</a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - DruzabniDogodki - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
